[Unit]
Description=strokov.me: сайт (Astro, Node)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@APP@/current
EnvironmentFile=@APP@/env
Environment=NODE_ENV=production NODE_NO_WARNINGS=1 HOST=127.0.0.1 PORT=4321 DATA_DIR=@APP@/data
ExecStart=@APP@/node/bin/node @APP@/current/dist/server/entry.mjs
Restart=always
RestartSec=3
MemoryMax=700M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=@APP@/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
