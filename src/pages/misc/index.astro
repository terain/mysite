---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entries = await getCollection('misc');
---

<Base section={{ href: '/misc', label: 'Другое' }} title="Другое">
  <h1>Другое</h1>
  <ul>
    {entries.map((e) => <li><a href={`/misc/${e.id}`}>{e.data.title}</a></li>)}
  </ul>
</Base>
