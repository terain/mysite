---
import Base from '../../layouts/Base.astro';
// Схема работы сайта на своём сервере. Раздел сам по себе, ссылок на него нет.

interface Box {
  x: number;
  y: number;
  w: number;
  h: number;
  title: string;
  sub: string;
  kind?: 'ext' | 'in' | 'you';
}
const boxes: Box[] = [
  { x: 20, y: 40, w: 170, h: 56, title: 'Посетитель', sub: 'браузер', kind: 'ext' },
  { x: 20, y: 150, w: 170, h: 64, title: 'DNS Cloudflare', sub: 'strokov.me → 2.29.204.181', kind: 'ext' },
  { x: 20, y: 330, w: 170, h: 56, title: 'Вы', sub: 'git push, SSH', kind: 'you' },
  { x: 20, y: 470, w: 170, h: 64, title: 'GitHub', sub: 'terain/mysite, ветка main', kind: 'ext' },
  { x: 530, y: 470, w: 170, h: 64, title: 'pCloud', sub: 'картинки и бэкапы', kind: 'ext' },
  { x: 260, y: 60, w: 410, h: 56, title: 'Caddy, порты 80 и 443', sub: 'HTTPS-сертификат, сжатие, кэш', kind: 'in' },
  { x: 260, y: 150, w: 410, h: 56, title: 'Сайт: Node.js + Astro', sub: '~/mysite, 127.0.0.1:4321', kind: 'in' },
  { x: 260, y: 240, w: 125, h: 64, title: 'Страницы', sub: 'готовые HTML', kind: 'in' },
  { x: 402.5, y: 240, w: 125, h: 64, title: 'База SQLite', sub: 'места, квест', kind: 'in' },
  { x: 545, y: 240, w: 125, h: 64, title: 'Кэш картинок', sub: '/media, 7 дней', kind: 'in' },
  { x: 260, y: 340, w: 410, h: 64, title: 'Таймеры', sub: 'обновление раз в 2 мин · бэкап в 03:00 UTC', kind: 'in' },
];

interface Arrow {
  d: string;
  label?: string;
  lx?: number;
  ly?: number;
  anchor?: 'start' | 'end' | 'middle';
  tone?: 'req' | 'deploy' | 'backup';
}
const arrows: Arrow[] = [
  { d: 'M105 96 V146', label: '1. где сайт?', lx: 112, ly: 126, anchor: 'start', tone: 'req' },
  { d: 'M190 68 H222 V88 H256', label: '2. запрос', lx: 196, ly: 60, anchor: 'start', tone: 'req' },
  { d: 'M465 116 V146', label: '3', lx: 472, ly: 136, anchor: 'start', tone: 'req' },
  { d: 'M420 206 L330 236', tone: 'req' },
  { d: 'M465 206 V236', tone: 'req' },
  { d: 'M510 206 L600 236', tone: 'req' },
  { d: 'M670 272 H712 V502 H704', label: 'нет в кэше', lx: 706, ly: 455, anchor: 'end', tone: 'req' },
  { d: 'M105 386 V466', label: 'git push', lx: 112, ly: 432, anchor: 'start', tone: 'deploy' },
  { d: 'M300 404 V502 H194', label: 'новый коммит?', lx: 306, ly: 455, anchor: 'start', tone: 'deploy' },
  { d: 'M560 404 V466', label: 'бэкап базы', lx: 554, ly: 455, anchor: 'end', tone: 'backup' },
  { d: 'M190 358 H226', label: 'SSH', lx: 208, ly: 350, anchor: 'middle', tone: 'deploy' },
];
---

<Base section={{ href: '/server', label: 'Сервер' }} title="Как работает сайт">
  <meta slot="head" name="robots" content="noindex" />
  <h1>Как работает сайт</h1>
  <p class="muted">
    strokov.me живёт на своём сервере в Hetzner. Ниже показано, что происходит, когда кто-то открывает сайт, когда вы
    делаете push и где хранятся данные.
  </p>

  <div class="legend">
    <span><i class="req"></i>запрос посетителя</span>
    <span><i class="deploy"></i>обновление сайта</span>
    <span><i class="backup"></i>бэкап</span>
  </div>

  <div class="scheme">
    <svg viewBox="0 0 720 550" role="img" aria-labelledby="scheme-title">
      <title id="scheme-title">Схема: посетитель, DNS, сервер Hetzner с Caddy и сайтом, GitHub и pCloud</title>
      <defs>
        {
          (['req', 'deploy', 'backup'] as const).map((t) => (
            <marker id={`arr-${t}`} class={t} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0 0 L10 5 L0 10 z" />
            </marker>
          ))
        }
      </defs>

      <rect class="group" x="230" y="20" width="470" height="410" rx="14" />
      <text class="group-label" x="246" y="44">Сервер Hetzner · Ubuntu · 2.29.204.181</text>

      {
        arrows.map((a) => (
          <g class={`arrow ${a.tone}`}>
            <path d={a.d} marker-end={`url(#arr-${a.tone})`} />
            {a.label && (
              <text x={a.lx} y={a.ly} text-anchor={a.anchor}>
                {a.label}
              </text>
            )}
          </g>
        ))
      }

      {
        boxes.map((b) => (
          <g class={`box ${b.kind}`}>
            <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="9" />
            <text class="t" x={b.x + b.w / 2} y={b.y + b.h / 2 - 4}>
              {b.title}
            </text>
            <text class="s" x={b.x + b.w / 2} y={b.y + b.h / 2 + 15}>
              {b.sub}
            </text>
          </g>
        ))
      }
    </svg>
  </div>

  <h2>Когда кто-то открывает сайт</h2>
  <ol>
    <li>Браузер спрашивает у DNS Cloudflare, где strokov.me, и получает IP сервера.</li>
    <li>Запрос приходит на сервер. Его принимает Caddy: он держит HTTPS-сертификат (продлевает сам) и сжимает ответы.</li>
    <li>
      Caddy передаёт запрос сайту. Обычные страницы это готовые файлы на диске, они отдаются сразу. Квест читает и
      пишет базу SQLite.
    </li>
    <li>
      Картинки по адресам <code>/media/…</code> лежат в pCloud. Сайт скачивает картинку один раз и неделю отдаёт её с
      диска сервера.
    </li>
  </ol>

  <h2>Когда вы обновляете сайт</h2>
  <ol>
    <li>Вы делаете <code>git push</code> в ветку <code>main</code> (или сливаете PR).</li>
    <li>Раз в 2 минуты сервер проверяет GitHub. Если появился новый коммит, он скачивает его в отдельную папку и собирает.</li>
    <li>Если сборка прошла, сайт переключается на новую версию и перезапускается за пару секунд. Если упала, продолжает работать старая.</li>
  </ol>

  <h2>Где что лежит</h2>
  <table>
    <tbody>
      <tr><td>Код сайта</td><td>GitHub, <code>terain/mysite</code></td></tr>
      <tr><td>Всё про сайт на сервере</td><td>одна папка <code>~/mysite</code> (<code>/home/tera/mysite</code>)</td></tr>
      <tr><td>Текущая версия</td><td><code>~/mysite/current</code> (последние 3 версии в <code>~/mysite/releases</code>)</td></tr>
      <tr><td>База</td><td><code>~/mysite/data/site.db</code></td></tr>
      <tr><td>Пароли и токены</td><td><code>~/mysite/env</code></td></tr>
      <tr><td>Бэкапы базы</td><td>pCloud, <code>/site/backup/db/</code>, каждый день, 30 последних</td></tr>
      <tr><td>Картинки</td><td>pCloud, <code>/site/media/</code></td></tr>
      <tr><td>Caddy, Node.js</td><td><code>~/mysite/Caddyfile</code>, <code>~/mysite/bin/caddy</code>, <code>~/mysite/node</code></td></tr>
      <tr><td>Вне папки</td><td>только ссылки на службы в <code>/etc/systemd/system</code> и правила файрвола для портов 80 и 443</td></tr>
    </tbody>
  </table>

  <h2>Если что-то не так</h2>
  <table>
    <tbody>
      <tr><td>Работает ли сайт</td><td><code>systemctl status mysite</code></td></tr>
      <tr><td>Логи сайта</td><td><code>journalctl -u mysite -n 100</code></td></tr>
      <tr><td>Логи обновления</td><td><code>journalctl -u mysite-update -n 50</code></td></tr>
      <tr><td>Обновить прямо сейчас</td><td><code>~/mysite/bin/update</code></td></tr>
      <tr><td>Вернуть прошлую версию</td><td><code>ls ~/mysite/releases</code>, затем <code>ln -sfn ~/mysite/releases/&lt;версия&gt; ~/mysite/current && touch ~/mysite/.restart</code></td></tr>
      <tr><td>Бэкап прямо сейчас</td><td><code>sudo systemctl start mysite-backup</code></td></tr>
      <tr><td>Сменить пароль админки или токен pCloud</td><td><code>~/mysite/bin/secrets</code></td></tr>
      <tr><td>Убрать сайт с сервера целиком</td><td><code>sudo ~/mysite/bin/uninstall && rm -rf ~/mysite</code></td></tr>
      <tr><td>Восстановить базу из pCloud</td><td><code>~/mysite/bin/import</code></td></tr>
    </tbody>
  </table>
</Base>

<style>
  .scheme {
    --box: #ffffff;
    --box-in: #eef3ff;
    --box-you: #fff4e0;
    --line: #8a8984;
    --req: #2f5fd0;
    --deploy: #b4691f;
    --backup: #2f8a57;
    margin: 20px 0 8px;
    overflow-x: auto;
  }
  @media (prefers-color-scheme: dark) {
    .scheme {
      --box: #1f1f1d;
      --box-in: #1c2438;
      --box-you: #33281a;
      --line: #77766f;
      --req: #7ea2ff;
      --deploy: #e0a060;
      --backup: #6cc590;
    }
  }
  svg {
    display: block;
    width: 100%;
    min-width: 560px;
    height: auto;
    font-family: inherit;
  }
  .group {
    fill: none;
    stroke: var(--border);
    stroke-width: 2;
    stroke-dasharray: 6 5;
  }
  .group-label {
    font-size: 13px;
    font-weight: 600;
    fill: var(--muted);
  }
  .box rect {
    fill: var(--box);
    stroke: var(--border);
    stroke-width: 1.5;
  }
  .box.in rect {
    fill: var(--box-in);
  }
  .box.you rect {
    fill: var(--box-you);
  }
  .box text {
    text-anchor: middle;
    fill: var(--text);
  }
  .box .t {
    font-size: 14px;
    font-weight: 650;
  }
  .box .s {
    font-size: 11.5px;
    fill: var(--muted);
  }
  .arrow path {
    fill: none;
    stroke-width: 2;
  }
  .arrow text {
    font-size: 11.5px;
    font-weight: 600;
  }
  .arrow.req path { stroke: var(--req); }
  .arrow.req text, marker.req path { fill: var(--req); }
  .arrow.deploy path { stroke: var(--deploy); }
  .arrow.deploy text, marker.deploy path { fill: var(--deploy); }
  .arrow.backup path { stroke: var(--backup); }
  .arrow.backup text, marker.backup path { fill: var(--backup); }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-size: 14px;
    color: var(--muted);
    margin-top: 16px;
  }
  .legend i {
    display: inline-block;
    width: 18px;
    height: 3px;
    border-radius: 2px;
    vertical-align: middle;
    margin-right: 6px;
  }
  .legend .req { background: #2f5fd0; }
  .legend .deploy { background: #b4691f; }
  .legend .backup { background: #2f8a57; }
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 15px;
  }
  td {
    border-top: 1px solid var(--border);
    padding: 8px 10px 8px 0;
    vertical-align: top;
  }
  td:first-child {
    color: var(--muted);
    width: 34%;
  }
  code {
    font-size: 0.9em;
    word-break: break-word;
  }
</style>
