---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import base from '../../../public/dnd/map/map.json';
import type { MapData } from '../../dnd/map';

const layers = (await getCollection('dndLayers')).map((l) => ({ id: l.id, ...l.data })).sort((a, b) => a.order - b.order);
const layerById = new Map(layers.map((l) => [l.id, l]));

const entries = (await getCollection('dndPlaces', (e) => !e.data.gmOnly)).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'ru'),
);
const places = await Promise.all(
  entries.map(async (e) => {
    const layerId = e.id.split('/')[0];
    const layer = layerById.get(layerId);
    if (!layer || !e.id.includes('/')) {
      throw new Error(`dnd-map/${e.id}: файл должен лежать в папке слоя (${layers.map((l) => l.id).join(', ')})`);
    }
    const { Content } = await render(e);
    return { entry: e, layer, Content };
  }),
);

const data: MapData = {
  base,
  layers: layers.map(({ id, title, kind, color, visible }) => ({ id, title, kind, color, visible })),
  places: places.map(({ entry: e, layer }) => ({
    id: e.id,
    layer: layer.id,
    title: e.data.title,
    summary: e.data.summary,
    icon: e.data.icon,
    color: e.data.color ?? layer.color,
    point: e.data.point,
    area: e.data.area,
  })),
};
---

<Base section={{ href: '/dnd', label: 'DnD' }} title="Карта мира — DnD" full>
  <div class="world">
    <aside class="layers" aria-label="Слои карты">
      <button type="button" class="layers-toggle" aria-expanded="false">Слои</button>
      <div class="layers-body">
        {
          data.layers.map((l) => {
            const items = data.places.filter((p) => p.layer === l.id);
            return (
              <section class="layer" style={`--c: ${l.color}`}>
                <label class="layer-head">
                  <input type="checkbox" data-layer={l.id} checked={l.visible} />
                  <span class="layer-title">{l.title}</span>
                  <span class="count">{items.length}</span>
                </label>
                <ul>
                  {items.map((p) => (
                    <li>
                      <button type="button" data-place={p.id} style={`--c: ${p.color}`}>
                        <span class:list={['mark', l.kind]}>{l.kind === 'icons' ? p.icon : ''}</span>
                        <span>
                          {p.title}
                          {p.summary && <small>{p.summary}</small>}
                        </span>
                      </button>
                    </li>
                  ))}
                </ul>
              </section>
            );
          })
        }
      </div>
    </aside>

    <div id="world-map"></div>

    <article id="info" class="info" hidden aria-live="polite">
      <button type="button" class="close" aria-label="Закрыть">×</button>
      <div class="info-body"></div>
    </article>

    <div id="edit-box" class="edit-box" hidden>
      <strong>Режим координат</strong>
      <p>Щелчок по карте — точка. Несколько щелчков — область.</p>
      <pre id="edit-out"></pre>
      <button type="button" id="edit-copy">Копировать</button>
      <button type="button" id="edit-reset">Сбросить</button>
    </div>
  </div>

  {
    places.map(({ entry, Content }) => (
      <template data-info={entry.id}>
        <h2>{entry.data.title}</h2>
        {entry.data.summary && <p class="summary">{entry.data.summary}</p>}
        <Content />
      </template>
    ))
  }
  <script type="application/json" id="world-data" set:html={JSON.stringify(data)} />
</Base>

<style is:global>
  .world {
    --left: 300px;
    --right: 0px;
    height: 100%;
    display: grid;
    grid-template-columns: var(--left) 1fr var(--right);
    transition: grid-template-columns 0.25s ease;
  }
  .world.open { --right: clamp(320px, 33%, 560px); }
  #world-map { min-height: 0; min-width: 0; background: #d9ccae; }

  .layers { border-right: 1px solid var(--border); background: var(--bg); overflow: auto; z-index: 2; }
  .layers-toggle { display: none; }
  .layers-body { padding: 12px 12px 20px; display: flex; flex-direction: column; gap: 14px; }
  .layer ul { list-style: none; margin: 4px 0 0; padding: 0; }
  .layer-head { display: flex; align-items: center; gap: 8px; font-weight: 600; cursor: pointer; }
  .layer-head input { accent-color: var(--c); }
  .layer-title { flex: 1; }
  .layer:has(.layer-head input:not(:checked)) ul { opacity: 0.45; }
  .count { color: var(--muted); font-size: 13px; font-weight: 400; }
  .layer button {
    display: flex; align-items: center; gap: 8px; width: 100%; text-align: left;
    background: none; border: 0; border-radius: 8px; padding: 5px 6px; font: inherit; font-size: 15px;
    color: var(--text); cursor: pointer;
  }
  .layer button:hover, .layer button[aria-current='true'] { background: color-mix(in srgb, var(--c) 14%, transparent); }
  .layer small { display: block; color: var(--muted); font-size: 13px; line-height: 1.3; }
  .mark { flex: none; width: 24px; height: 24px; display: grid; place-items: center; font-size: 13px; border-radius: 50%; background: var(--c); }
  .mark.zones { border-radius: 5px; background: color-mix(in srgb, var(--c) 35%, transparent); border: 2px solid var(--c); }

  .info { border-left: 1px solid var(--border); background: var(--bg); overflow: auto; position: relative; min-width: 0; }
  .info[hidden] { display: block; visibility: hidden; }
  .info-body { padding: 18px 20px 32px; }
  .info h2 { margin: 0 36px 4px 0; font-size: 24px; line-height: 1.25; }
  .info .summary { color: var(--muted); margin: 0 0 12px; }
  .info img { max-width: 100%; height: auto; border-radius: 8px; }
  .info .close {
    position: absolute; top: 10px; right: 10px; width: 32px; height: 32px; border-radius: 50%;
    border: 1px solid var(--border); background: var(--bg); color: var(--text); font-size: 20px; line-height: 1; cursor: pointer;
  }

  .place-icon span {
    width: 28px; height: 28px; display: grid; place-items: center; font-size: 15px; border-radius: 50%;
    background: var(--c); border: 2px solid #fff; box-shadow: 0 1px 4px rgb(0 0 0 / 0.45);
  }
  .place-icon.active span { outline: 3px solid #ffd257; }
  .leaflet-container { font: inherit; }

  .edit-box {
    position: fixed; left: calc(var(--left, 300px) + 12px); bottom: 12px; z-index: 1000; max-width: 360px;
    background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; font-size: 14px;
  }
  .edit-box p { margin: 4px 0; color: var(--muted); }
  .edit-box pre { margin: 6px 0; white-space: pre-wrap; max-height: 30vh; overflow: auto; font-size: 13px; }

  @media (max-width: 760px) {
    .world { grid-template-columns: 1fr; grid-template-rows: auto 1fr; position: relative; }
    .world.open { --right: 0px; }
    .layers { border-right: 0; border-bottom: 1px solid var(--border); max-height: 50dvh; }
    .layers-toggle { display: block; width: 100%; padding: 10px 16px; text-align: left; font: inherit; font-weight: 600; background: none; border: 0; color: var(--text); }
    .layers-body { display: none; padding-top: 0; }
    .layers.expanded .layers-body { display: flex; }
    .info { position: absolute; left: 0; right: 0; bottom: 0; max-height: 60%; z-index: 1000; border: 0; border-top: 1px solid var(--border); border-radius: 14px 14px 0 0; box-shadow: 0 -4px 16px rgb(0 0 0 / 0.2); }
    .info[hidden] { display: none; }
    .edit-box { left: 12px; }
  }
</style>

<script>
  import { createWorldMap, placeIcon, toLatLng, L, type MapData } from '../../dnd/map';

  const data: MapData = JSON.parse(document.getElementById('world-data')!.textContent!);
  const app = document.querySelector<HTMLElement>('.world')!;
  const mapEl = document.getElementById('world-map')!;
  const info = document.getElementById('info')!;
  const infoBody = info.querySelector<HTMLElement>('.info-body')!;
  const { map } = createWorldMap(mapEl, data.base);

  // Размер карты меняется, когда выезжает панель справа
  new ResizeObserver(() => map.invalidateSize({ pan: false })).observe(mapEl);

  const groups = new Map<string, L.LayerGroup>();
  const shapes = new Map<string, L.Marker | L.Polygon>();

  for (const layer of data.layers) {
    const group = L.layerGroup();
    groups.set(layer.id, group);
    if (layer.visible) group.addTo(map);
  }

  for (const p of data.places) {
    const group = groups.get(p.layer)!;
    let shape: L.Marker | L.Polygon;
    if (p.area) {
      shape = L.polygon(p.area.map(toLatLng), { color: p.color, weight: 2, fillOpacity: 0.22 });
    } else {
      shape = L.marker(toLatLng(p.point!), { icon: placeIcon(p), title: p.title, riseOnHover: true });
    }
    shape.bindTooltip(p.title, { sticky: !!p.area, direction: 'top', offset: p.area ? [0, -8] : [0, -14] });
    shape.on('click', () => select(p.id));
    shape.addTo(group);
    shapes.set(p.id, shape);
  }

  document.querySelectorAll<HTMLInputElement>('input[data-layer]').forEach((box) =>
    box.addEventListener('change', () => {
      const group = groups.get(box.dataset.layer!)!;
      if (box.checked) group.addTo(map);
      else group.remove();
    }),
  );

  let current: string | null = null;
  const mobile = matchMedia('(max-width: 760px)');

  function select(id: string | null, fly = false) {
    if (current) setActive(current, false);
    current = id;
    const place = id && data.places.find((p) => p.id === id);
    const tpl = id && document.querySelector<HTMLTemplateElement>(`template[data-info="${CSS.escape(id)}"]`);
    if (!place || !tpl) {
      app.classList.remove('open');
      info.hidden = true;
      if (location.hash) history.replaceState(null, '', location.pathname + location.search);
      return;
    }
    infoBody.replaceChildren(tpl.content.cloneNode(true));
    info.scrollTop = 0;
    info.hidden = false;
    app.classList.add('open');
    setActive(id, true);
    history.replaceState(null, '', '#' + id);

    // Если слой выключен — включаем, иначе объект не видно
    const box = document.querySelector<HTMLInputElement>(`input[data-layer="${CSS.escape(place.layer)}"]`);
    if (box && !box.checked) {
      box.checked = true;
      groups.get(place.layer)!.addTo(map);
    }
    // Ждём, пока панель выедет, потом показываем объект
    setTimeout(() => {
      const shape = shapes.get(id)!;
      const target = shape instanceof L.Polygon ? shape.getBounds() : L.latLngBounds([shape.getLatLng()]);
      if (mobile.matches) {
        // На телефоне карточка снизу закрывает полэкрана — ставим объект в верхнюю четверть
        map.setView(target.getCenter(), fly ? Math.max(map.getZoom(), map.getMinZoom() + 2) : map.getZoom(), { animate: false });
        map.panBy([0, mapEl.clientHeight * 0.25], { animate: false });
      } else if (fly) {
        map.flyToBounds(target, { maxZoom: Math.max(map.getZoom(), map.getMinZoom() + 2), padding: [40, 40] });
      } else if (!map.getBounds().contains(target)) {
        map.panTo(target.getCenter());
      }
    }, 280);
  }

  function setActive(id: string, on: boolean) {
    const shape = shapes.get(id);
    if (shape instanceof L.Polygon) shape.setStyle({ weight: on ? 4 : 2, fillOpacity: on ? 0.35 : 0.22 });
    else shape?.getElement()?.classList.toggle('active', on);
    document.querySelector(`button[data-place="${CSS.escape(id)}"]`)?.setAttribute('aria-current', String(on));
  }

  document.querySelectorAll<HTMLButtonElement>('button[data-place]').forEach((b) =>
    b.addEventListener('click', () => {
      select(b.dataset.place!, true);
      document.querySelector('.layers')!.classList.remove('expanded');
    }),
  );
  info.querySelector('.close')!.addEventListener('click', () => select(null));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && select(null));

  const toggle = document.querySelector<HTMLButtonElement>('.layers-toggle')!;
  toggle.addEventListener('click', () => {
    const open = document.querySelector('.layers')!.classList.toggle('expanded');
    toggle.setAttribute('aria-expanded', String(open));
  });

  const initial = decodeURIComponent(location.hash.slice(1));
  if (initial) select(initial, true);

  // /dnd/map?edit — подсказка координат для frontmatter
  if (new URLSearchParams(location.search).has('edit')) {
    const box = document.getElementById('edit-box')!;
    const out = document.getElementById('edit-out')!;
    const pts: [number, number][] = [];
    const line = L.polyline([], { color: '#e0328a', weight: 2, dashArray: '4 4' }).addTo(map);
    const render = () => {
      out.textContent = !pts.length
        ? ''
        : pts.length === 1
          ? `point: [${pts[0].join(', ')}]`
          : `area: [${pts.map((p) => `[${p.join(', ')}]`).join(', ')}]`;
      line.setLatLngs(pts.map(toLatLng));
    };
    box.hidden = false;
    mapEl.style.cursor = 'crosshair';
    map.on('click', (e: L.LeafletMouseEvent) => {
      pts.push([Math.round(e.latlng.lng), Math.round(e.latlng.lat)]);
      render();
    });
    document.getElementById('edit-copy')!.addEventListener('click', () => navigator.clipboard.writeText(out.textContent ?? ''));
    document.getElementById('edit-reset')!.addEventListener('click', () => {
      pts.length = 0;
      render();
    });
  }
</script>
