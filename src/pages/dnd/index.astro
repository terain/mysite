---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entries = (await getCollection('dnd', (e) => !e.data.gmOnly)).sort((a, b) => a.data.order - b.data.order);
---

<Base section={{ href: '/dnd', label: 'DnD' }} title="DnD">
  <h1>DnD</h1>
  <ul>
    {entries.map((e) => <li><a href={`/dnd/${e.id}`}>{e.data.title}</a></li>)}
  </ul>
</Base>
