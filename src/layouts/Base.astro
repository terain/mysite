---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  // Разделы изолированы: в шапке только свой раздел, ссылок на другие нет.
  section?: { href: string; label: string };
}
const { title, description, lang = 'ru', section } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <slot name="head" />
  </head>
  <body>
    {
      section && (
        <header class="site">
          <nav class="wrap">
            <a class="brand" href={section.href}>{section.label}</a>
          </nav>
        </header>
      )
    }
    <main class="wrap">
      <slot />
    </main>
  </body>
</html>
