{
  "name": "mysite",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "astro build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply mysite-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply mysite-db --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.1",
    "astro": "^7.4.1",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.24.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.3"
  }
}
